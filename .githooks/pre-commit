#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! git ls-files --error-unmatch -- pubspec.yaml >/dev/null 2>&1; then
  printf '%s\n' 'Cannot bump the build number: stage pubspec.yaml first.' >&2
  exit 1
fi

if ! git diff --quiet -- pubspec.yaml; then
  printf '%s\n' 'Cannot bump the build number: pubspec.yaml has unstaged changes. Stage or discard them before committing.' >&2
  exit 1
fi

version=$(sed -nE 's/^version:[[:space:]]*([0-9]+\.[0-9]+\.[0-9]+)\+([0-9]+)[[:space:]]*$/\1 \2/p' pubspec.yaml)
if [ -z "$version" ]; then
  printf '%s\n' 'Cannot bump the build number: expected version: MAJOR.MINOR.PATCH+BUILD in pubspec.yaml.' >&2
  exit 1
fi

set -- $version
release_version=$1
build_number=$2
next_build=$((build_number + 1))
updated_version="$release_version+$next_build"

tmp_file=$(mktemp "$repo_root/.pubspec.yaml.XXXXXX")
trap 'rm -f "$tmp_file"' EXIT HUP INT TERM
awk -v replacement="version: $updated_version" '
  /^version:/ { print replacement; next }
  { print }
' pubspec.yaml > "$tmp_file"
cat "$tmp_file" > pubspec.yaml
git add -- pubspec.yaml
printf 'Build number: %s -> %s\n' "$build_number" "$next_build"
